      "source": [
        "# Re-run data cleaning and preparation\n",
        "import re\n",
        "\n",
        "# 1. Convert the 'Time' column to datetime objects\n",
        "df_tamale['Time'] = pd.to_datetime(df_tamale['Time']).dt.time\n",
        "df_kumasi['Time'] = pd.to_datetime(df_kumasi['Time']).dt.time\n",
        "\n",
        "# 2. Combine 'Date' and 'Time' into a single 'Datetime' column and set as index\n",
        "df_tamale['Datetime'] = pd.to_datetime(df_tamale['Date'].astype(str) + ' ' + df_tamale['Time'].astype(str))\n",
        "df_tamale = df_tamale.set_index('Datetime')\n",
        "df_tamale = df_tamale.drop(columns=['Date', 'Time'])\n",
        "\n",
        "df_kumasi['Datetime'] = pd.to_datetime(df_kumasi['Date'].astype(str) + ' ' + df_kumasi['Time'].astype(str))\n",
        "df_kumasi = df_kumasi.set_index('Datetime')\n",
        "df_kumasi = df_kumasi.drop(columns=['Date', 'Time'])\n",
        "\n",
        "# 3. Handle missing values using forward fill\n",
        "df_tamale.fillna(method='ffill', inplace=True)\n",
        "df_kumasi.fillna(method='ffill', inplace=True)\n",
        "\n",
        "# 4. Standardize column names\n",
        "def standardize_col_names(df):\n",
        "    cols = df.columns\n",
        "    new_cols = []\n",
        "    for col in cols:\n",
        "        new_col = re.sub(r'[^a-zA-Z0-9\\s]', '', col) # Remove special characters except spaces\n",
        "        new_col = new_col.strip() # Remove leading/trailing spaces\n",
        "        new_col = re.sub(r'\\s+', '_', new_col) # Replace spaces with underscores\n",
        "        new_cols.append(new_col)\n",
        "    df.columns = new_cols\n",
        "    return df\n",
        "\n",
        "df_tamale = standardize_col_names(df_tamale)\n",
        "df_kumasi = standardize_col_names(df_kumasi)\n",
        "\n",
        "print(\"Data cleaning and preparation re-done.\")"
