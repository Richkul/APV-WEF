        "import numpy as np\n",
        "\n",
        "# Re-identify Extreme Outliers and Replace with NaN\n",
        "# We will use the same key_params that were used for the descriptive statistics and correlation analysis\n",
        "\n",
        "def identify_and_replace_extreme_outliers(df, columns):\n",
        "    \"\"\"\n",
        "    Identifies extreme outliers in specified DataFrame columns using the IQR method\n",
        "    and replaces them with NaN.\n",
        "\n",
        "    Args:\n",
        "        df (pd.DataFrame): The input DataFrame.\n",
        "        columns (list): A list of column names to analyze.\n",
        "\n",
        "    Returns:\n",
        "        pd.DataFrame: The DataFrame with extreme outliers replaced by NaN.\n",
        "    \"\"\"\n",
        "    df_cleaned = df.copy()\n",
        "    for col in columns:\n",
        "        if col in df_cleaned.columns:\n",
        "            Q1 = df_cleaned[col].quantile(0.25)\n",
        "            Q3 = df_cleaned[col].quantile(0.75)\n",
        "            IQR = Q3 - Q1\n",
        "\n",
        "            lower_bound = Q1 - 3 * IQR\n",
        "            upper_bound = Q3 + 3 * IQR\n",
        "\n",
        "            # Identify extreme outliers\n",
        "            outliers = (df_cleaned[col] < lower_bound) | (df_cleaned[col] > upper_bound)\n",
        "\n",
        "            # Replace extreme outliers with NaN\n",
        "            df_cleaned.loc[outliers, col] = np.nan\n",
        "    return df_cleaned\n",
        "\n",
        "df_tamale_cleaned_outliers = identify_and_replace_extreme_outliers(df_tamale, key_params)\n",
        "df_kumasi_cleaned_outliers = identify_and_replace_extreme_outliers(df_kumasi, key_params)\n",
        "\n",
        "print(\"Extreme outliers replaced with NaN.\")\n",
        "\n",
        "# Apply Interpolation Method\n",
        "# Use time-based interpolation to fill NaN values\n",
        "df_tamale_interpolated = df_tamale_cleaned_outliers.interpolate(method='time')\n",
        "df_kumasi_interpolated = df_kumasi_cleaned_outliers.interpolate(method='time')\n",
        "\n",
        "\n",
        "print(\"NaN values interpolated using time-based method.\")\n",
        "\n",
        "# Verify Outlier Removal and Interpolation\n",
        "print(\"\\nMissing values remaining after interpolation (Tamale):\")\n",
        "print(df_tamale_interpolated[key_params].isnull().sum())\n",
        "\n",
        "print(\"\\nMissing values remaining after interpolation (Kumasi):\")\n",
        "print(df_kumasi_interpolated[key_params].isnull().sum())\n",
        "\n",
        "# Replace original dataframes with interpolated ones for subsequent analysis\n",
        "df_tamale = df_tamale_interpolated.copy()\n",
        "df_kumasi = df_kumasi_interpolated.copy()\n",
        "\n",
        "print(\"\\nOutlier removal and interpolation complete. Original dataframes updated.\")"
