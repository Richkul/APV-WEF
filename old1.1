      "source": [
        "# Compare Agrivoltaic vs Photovoltaic-Only Panel Temperatures (Task 2)\n",
        "\n",
        "# Function to create comparison box plots for Task 2\n",
        "def plot_av_pv_temperature_comparison(df_av_pt, df_pv_pt, location, crops, unit):\n",
        "    \"\"\"\n",
        "    Generates box plots comparing PV panel temperatures in Agrivoltaics plots\n",
        "    for each crop vs. Photovoltaics-only plots for a given location.\n",
        "\n",
        "    Args:\n",
        "        df_av_pt (pd.DataFrame): DataFrame for Agrivoltaics PV panel temperatures for all crops.\n",
        "        df_pv_pt (pd.DataFrame): DataFrame for Photovoltaics-only PV panel temperatures.\n",
        "        location (str): Name of the location (e.g., 'Tamale', 'Kumasi').\n",
        "        crops (list): List of crop names (e.g., ['Tomato', 'Pepper', 'Eggplant']).\n",
        "        unit (str): Unit of the temperature (e.g., '°C').\n",
        "    \"\"\"\n",
        "    for i, crop in enumerate(crops):\n",
        "        # Combine data for the current crop's Agrivoltaics PV temperature and Photovoltaics-only PV temperature\n",
        "        df_av_crop_pt = df_av_pt[[df_av_pt.columns[i]]].copy()\n",
        "        df_av_crop_pt['Treatment'] = f'Agrivoltaics ({crop})'\n",
        "        df_av_crop_pt['Parameter'] = 'PV Panel Temperature'\n",
        "        df_av_crop_pt.rename(columns={df_av_crop_pt.columns[0]: 'Value'}, inplace=True)\n",
        "\n",
        "        df_pv_pt_single = df_pv_pt.copy()\n",
        "        df_pv_pt_single['Treatment'] = 'Photovoltaics Only'\n",
        "        df_pv_pt_single['Parameter'] = 'PV Panel Temperature'\n",
        "        df_pv_pt_single.rename(columns={df_pv_pt_single.columns[0]: 'Value'}, inplace=True)\n",
        "\n",
        "\n",
        "        df_combined_pt = pd.concat([df_av_crop_pt, df_pv_pt_single])\n",
        "\n",
        "        plt.figure(figsize=(8, 6))\n",
        "        sns.boxplot(data=df_combined_pt, x='Treatment', y='Value', hue='Treatment', palette={f'Agrivoltaics ({crop})': 'green', 'Photovoltaics Only': 'blue'}, legend=False) # Modified palette\n",
        "        plt.title(f'PV Panel Temperature Distribution in {location} - {crop} (AV vs PV Only)')\n",
        "        plt.xlabel('Treatment')\n",
        "        plt.ylabel(f'PV Panel Temperature ({unit})')\n",
        "        plt.grid(False)\n",
        "        plt.show()\n",
        "\n",
        "\n",
        "# Define crops\n",
        "crops = ['Tomato', 'Pepper', 'Eggplant']\n",
        "\n",
        "# Plot for Tamale\n",
        "plot_av_pv_temperature_comparison(df_tamale[cols_tamale_av_pt], df_tamale[cols_tamale_pv_pt], 'Tamale', crops, '°C')\n",
        "\n",
        "# Plot for Kumasi\n",
        "plot_av_pv_temperature_comparison(df_kumasi[cols_kumasi_av_pt], df_kumasi[cols_kumasi_pv_pt], 'Kumasi', crops, '°C')"
      ],
