      "source": [
        "import matplotlib.pyplot as plt\n",
        "from mpl_toolkits.mplot3d import Axes3D\n",
        "import numpy as np\n",
        "\n",
        "# Function to generate 3D surface plot\n",
        "def plot_3d_surface(df, title, xlabel, ylabel, zlabel):\n",
        "    \"\"\"\n",
        "    Generates a 3D surface plot.\n",
        "\n",
        "    Args:\n",
        "        df (pd.DataFrame): The input DataFrame with three columns for x, y, and z.\n",
        "        title (str): The title of the plot.\n",
        "        xlabel (str): The label for the x-axis.\n",
        "        ylabel (str): The label for the y-axis.\n",
        "        zlabel (str): The label for the z-axis.\n",
        "    \"\"\"\n",
        "    fig = plt.figure(figsize=(10, 8))\n",
        "    ax = fig.add_subplot(111, projection='3d')\n",
        "\n",
        "    # For surface plots, it's often better to use a meshgrid if the data allows\n",
        "    # However, with scattered data like this, a scatter plot can be more appropriate\n",
        "    # If a surface is strictly required, we might need to interpolate\n",
        "    # For now, let's create a scatter plot to visualize the relationship\n",
        "\n",
        "    ax.scatter(df.iloc[:, 0], df.iloc[:, 1], df.iloc[:, 2], c=df.iloc[:, 2], cmap='viridis', marker='o')\n",
        "\n",
        "    ax.set_xlabel(xlabel)\n",
        "    ax.set_ylabel(ylabel)\n",
        "    ax.set_zlabel(zlabel)\n",
        "    ax.set_title(title)\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "# Generate plots for Tamale - Agrivoltaics\n",
        "plot_3d_surface(df_tamale_av, '3D Relationship in Tamale - Agrivoltaics', 'PV Solar Radiation (W/m²)', 'Air Temperature (°C)', 'PV Panel Temperature (°C)')\n",
        "\n",
        "# Generate plots for Kumasi - Agrivoltaics\n",
        "plot_3d_surface(df_kumasi_av, '3D Relationship in Kumasi - Agrivoltaics', 'PV Solar Radiation (W/m²)', 'Air Temperature (°C)', 'PV Panel Temperature (°C)')\n",
        "\n",
        "# Generate plots for Tamale - Photovoltaics Only\n",
        "plot_3d_surface(df_tamale_pv, '3D Relationship in Tamale - Photovoltaics Only', 'PV Solar Radiation (W/m²)', 'Ambient Temperature (°C)', 'PV Panel Temperature (°C)')\n",
        "\n",
        "# Generate plots for Kumasi - Photovoltaics Only\n",
        "plot_3d_surface(df_kumasi_pv, '3D Relationship in Kumasi - Photovoltaics Only', 'PV Solar Radiation (W/m²)', 'Ambient Temperature (°C)', 'PV Panel Temperature (°C)')"
