        "import os\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import re\n",
        "\n",
        "# Load data (from cell 6e8e4baa)\n",
        "df_tamale = pd.read_excel(\"Tamale_cleaned.xlsx\")\n",
        "df_kumasi = pd.read_excel(\"Kumasi_cleaned.xlsx\")\n",
        "\n",
        "# Data cleaning and preparation (from cell 15d4b505)\n",
        "# 1. Convert the 'Time' column to datetime objects\n",
        "df_tamale['Time'] = pd.to_datetime(df_tamale['Time']).dt.time\n",
        "df_kumasi['Time'] = pd.to_datetime(df_kumasi['Time']).dt.time\n",
        "\n",
        "# 2. Combine 'Date' and 'Time' into a single 'Datetime' column and set as index\n",
        "df_tamale['Datetime'] = pd.to_datetime(df_tamale['Date'].astype(str) + ' ' + df_tamale['Time'].astype(str))\n",
        "df_tamale = df_tamale.set_index('Datetime')\n",
        "df_tamale = df_tamale.drop(columns=['Date', 'Time'])\n",
        "\n",
        "df_kumasi['Datetime'] = pd.to_datetime(df_kumasi['Date'].astype(str) + ' ' + df_kumasi['Time'].astype(str))\n",
        "df_kumasi = df_kumasi.set_index('Datetime')\n",
        "df_kumasi = df_kumasi.drop(columns=['Date', 'Time'])\n",
        "\n",
        "# 3. Handle missing values using forward fill\n",
        "df_tamale.fillna(method='ffill', inplace=True)\n",
        "df_kumasi.fillna(method='ffill', inplace=True)\n",
        "\n",
        "# 4. Standardize column names\n",
        "def standardize_col_names(df):\n",
        "    cols = df.columns\n",
        "    new_cols = []\n",
        "    for col in cols:\n",
        "        new_col = re.sub(r'[^a-zA-Z0-9\\s]', '', col) # Remove special characters except spaces\n",
        "        new_col = new_col.strip() # Remove leading/trailing spaces\n",
        "        new_col = re.sub(r'\\s+', '_', new_col) # Replace spaces with underscores\n",
        "        new_cols.append(new_col)\n",
        "    df.columns = new_cols\n",
        "    return df\n",
        "\n",
        "df_tamale = standardize_col_names(df_tamale)\n",
        "df_kumasi = standardize_col_names(df_kumasi)\n",
        "\n",
        "\n",
        "# Create a directory to save figures if it doesn't exist\n",
        "if not os.path.exists('Results_Figures'):\n",
        "    os.makedirs('Results_Figures')\n",
        "\n",
        "# Save diurnal pattern plots\n",
        "key_params_diurnal = [\n",
        "    'Volumetric_soil_watermoisture_content_at_Agriculture_only_for_tomato_relative_humidity',\n",
        "    'Soil_temperature_at_Agriculture_only_for_Tomato_oC',\n",
        "    'Volumetric_soil_watermoisture_content_at_Agriculture_only_for_pepper_relative_humidity',\n",
        "    'Soil_temperature_at_Agriculture_only_for_pepper_oC',\n",
        "    'Volumetric_soil_watermoisture_content_at_Agriculture_only_for_Eggplant_relative_humidity',\n",
        "    'Soil_temperature_at_Agriculture_only_for_Eggplant_oC',\n",
        "    'PV_solar_radiation_at_Photovoltaics_only_Wm2',\n",
        "    'Weather_station_measuring_Relative_humidity_of_location',\n",
        "    'Weather_station_measuring_Temperature_oC',\n",
        "    'Weather_station_measuring_Precipitation_mm'\n",
        "]\n",
        "\n",
        "# Recalculate diurnal and seasonal patterns, and correlation matrices\n",
        "df_tamale['hour'] = df_tamale.index.hour\n",
        "df_tamale['month'] = df_tamale.index.month\n",
        "df_kumasi['hour'] = df_kumasi.index.hour\n",
        "df_kumasi['month'] = df_kumasi.index.month\n",
        "\n",
        "diurnal_tamale = df_tamale.groupby('hour')[key_params_diurnal].mean()\n",
        "seasonal_tamale = df_tamale.groupby('month')[key_params_diurnal].mean()\n",
        "diurnal_kumasi = df_kumasi.groupby('hour')[key_params_diurnal].mean()\n",
        "seasonal_kumasi = df_kumasi.groupby('month')[key_params_diurnal].mean()\n",
        "\n",
        "correlation_matrix_tamale = df_tamale[key_params_diurnal].corr()\n",
        "correlation_matrix_kumasi = df_kumasi[key_params_diurnal].corr()\n",
        "\n",
        "# Save diurnal pattern plots\n",
        "for param in key_params_diurnal:\n",
        "    plt.figure(figsize=(12, 6))\n",
        "    sns.lineplot(data=diurnal_tamale, x='hour', y=param, label='Tamale', color='green')\n",
        "    sns.lineplot(data=diurnal_kumasi, x='hour', y=param, label='Kumasi', color='blue')\n",
        "    plt.title(f'Diurnal Pattern of {param}')\n",
        "    plt.xlabel('Hour of the Day')\n",
        "    plt.ylabel(param)\n",
        "    plt.xticks(range(0, 24))\n",
        "    plt.grid(False)\n",
        "    plt.legend()\n",
        "    plt.savefig(f'Results_Figures/Diurnal_Pattern_{param}.png')\n",
        "    plt.close() # Close the plot after saving to free memory\n",
        "\n",
        "# Save seasonal pattern plots\n",
        "for param in key_params_diurnal: # Use the same key parameters as diurnal\n",
        "    plt.figure(figsize=(12, 6))\n",
        "    sns.lineplot(data=seasonal_tamale, x='month', y=param, label='Tamale', color='green')\n",
        "    sns.lineplot(data=seasonal_kumasi, x='month', y=param, label='Kumasi', color='blue')\n",
        "    plt.title(f'Seasonal Pattern of {param}')\n",
        "    plt.xlabel('Month')\n",
        "    plt.ylabel(param)\n",
        "    plt.xticks(range(1, 13))\n",
        "    plt.grid(False)\n",
        "    plt.legend()\n",
        "    plt.savefig(f'Results_Figures/Seasonal_Pattern_{param}.png')\n",
        "    plt.close() # Close the plot after saving to free memory\n",
        "\n",
        "# Save correlation heatmaps\n",
        "plt.figure(figsize=(12, 10))\n",
        "sns.heatmap(correlation_matrix_tamale, annot=True, cmap='coolwarm', fmt=\".2f\")\n",
        "plt.title('Correlation Matrix - Tamale')\n",
        "plt.savefig('Results_Figures/Correlation_Matrix_Tamale.png')\n",
        "plt.close()\n",
        "\n",
        "plt.figure(figsize=(12, 10))\n",
        "sns.heatmap(correlation_matrix_kumasi, annot=True, cmap='coolwarm', fmt=\".2f\")\n",
        "plt.title('Correlation Matrix - Kumasi')\n",
        "plt.savefig('Results_Figures/Correlation_Matrix_Kumasi.png')\n",
        "plt.close()\n",
        "\n",
        "# Save diurnal VPD pattern plot\n",
        "# Assuming df_tamale and df_kumasi with 'Weather_Station_VPD_kPa' are available\n",
        "plt.figure(figsize=(12, 6))\n",
        "sns.lineplot(data=df_tamale, x=df_tamale.index.hour, y='Weather_Station_VPD_kPa', label='Tamale', color='green')\n",
        "sns.lineplot(data=df_kumasi, x=df_kumasi.index.hour, y='Weather_Station_VPD_kPa', label='Kumasi', color='blue')\n",
        "plt.title('Diurnal Pattern of Weather Station VPD')\n",
        "plt.xlabel('Hour of the Day')\n",
        "plt.ylabel('Weather Station VPD (kPa)')\n",
        "plt.xticks(range(0, 24))\n",
        "plt.grid(False)\n",
        "plt.legend()\n",
        "plt.savefig('Results_Figures/Diurnal_VPD_Pattern.png')\n",
        "plt.close()\n",
        "\n",
        "print(\"Successfully re-saved generated graphs to 'Results_Figures' folder.\")"
