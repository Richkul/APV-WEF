        "        df_av (pd.DataFrame): DataFrame for Agrivoltaics data (should contain only the relevant columns for the crop).\n",
        "        location (str): Name of the location (e.g., 'Tamale', 'Kumasi').\n",
        "        crop (str): Name of the crop (e.g., 'Tomato', 'Pepper', 'Eggplant').\n",
        "        parameters_ag_av (list): List of tuples, where each tuple contains (ag_col, av_col, param_name, unit).\n",
        "    \"\"\"\n",
        "    for ag_param_col, av_param_col, param_name, unit in parameters_ag_av:\n",
        "        # Combine data for the current parameter from both treatments\n",
        "        # Extract the specific parameter column from the dataframes passed\n",
        "        df_ag_param_single = df_ag[[ag_param_col]].copy()\n",
        "        df_ag_param_single['Treatment'] = 'Agriculture Only'\n",
        "        df_ag_param_single['Parameter'] = param_name\n",
        "        df_ag_param_single.rename(columns={ag_param_col: 'Value'}, inplace=True)\n",
        "\n",
        "        df_av_param_single = df_av[[av_param_col]].copy()\n",
        "        df_av_param_single['Treatment'] = 'Agrivoltaics'\n",
        "        df_av_param_single['Parameter'] = param_name\n",
        "        df_av_param_single.rename(columns={av_param_col: 'Value'}, inplace=True)\n",
        "\n",
        "        df_combined_param = pd.concat([df_ag_param_single, df_av_param_single])\n",
        "\n",
        "        plt.figure(figsize=(8, 6))\n",
        "        sns.boxplot(data=df_combined_param, x='Treatment', y='Value', palette={'Agriculture Only': 'green', 'Agrivoltaics': 'blue'})\n",
        "        plt.title(f'{param_name} Distribution in {location} - {crop} (AG vs AV)')\n",
        "        plt.xlabel('Treatment')\n",
