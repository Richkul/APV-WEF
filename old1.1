      "source": [
        "# Prepare data for box plots by combining dataframes and adding a location column\n",
        "df_tamale['Location'] = 'Tamale'\n",
        "df_kumasi['Location'] = 'Kumasi'\n",
        "\n",
        "# Reset index before concatenating to avoid duplicate index issues\n",
        "df_tamale_reset = df_tamale.reset_index()\n",
        "df_kumasi_reset = df_kumasi.reset_index()\n",
        "\n",
        "df_combined = pd.concat([df_tamale_reset[key_params_diurnal + ['Location']], df_kumasi_reset[key_params_diurnal + ['Location']]])\n",
        "\n",
        "# Reset index of the combined dataframe as well\n",
        "df_combined = df_combined.reset_index(drop=True)\n",
        "\n",
        "# Define colors for locations\n",
        "location_colors = {'Tamale': 'green', 'Kumasi': 'blue'}\n",
        "\n",
        "# Create a directory to save figures if it doesn't exist\n",
        "if not os.path.exists('Results_Figures'):\n",
        "    os.makedirs('Results_Figures')\n",
        "\n",
        "# Plot box plots for each key parameter\n",
        "for param in key_params_diurnal:\n",
        "    plt.figure(figsize=(8, 6))\n",
        "    sns.boxplot(data=df_combined, x='Location', y=param, palette=location_colors)\n",
        "    plt.title(f'Distribution of {param} between Tamale and Kumasi')\n",
        "    plt.xlabel('Location')\n",
        "    plt.ylabel(param)\n",
        "    plt.grid(False) # Remove grid lines\n",
        "    # Save the plot\n",
        "    plt.savefig(f'Results_Figures/Boxplot_Distribution_{param}.png')\n",
        "    plt.close() # Close the plot to free memory\n",
        "\n",
