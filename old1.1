        "import numpy as np\n",
        "\n",
        "# 1. Analyze the distribution of key environmental parameters using descriptive statistics\n",
        "key_params = [\n",
        "    'Volumetric_soil_watermoisture_content_at_Agriculture_only_for_tomato_relative_humidity',\n",
