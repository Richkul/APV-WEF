        "\n",
        "# 2. Calculate diurnal and seasonal patterns\n",
        "df_tamale['hour'] = df_tamale.index.hour\n",
        "df_tamale['month'] = df_tamale.index.month\n",
        "df_kumasi['hour'] = df_kumasi.index.hour\n",
        "df_kumasi['month'] = df_kumasi.index.month\n",
        "\n",
        "diurnal_tamale = df_tamale.groupby('hour')[key_params].mean()\n",
        "seasonal_tamale = df_tamale.groupby('month')[key_params].mean()\n",
        "diurnal_kumasi = df_kumasi.groupby('hour')[key_params].mean()\n",
        "seasonal_kumasi = df_kumasi.groupby('month')[key_params].mean()\n",
        "\n",
        "print(\"\\nDiurnal Patterns for Tamale (Mean by Hour):\")\n",
        "display(diurnal_tamale)\n",
        "print(\"\\nSeasonal Patterns for Tamale (Mean by Month):\")\n",
        "display(seasonal_tamale)\n",
        "print(\"\\nDiurnal Patterns for Kumasi (Mean by Hour):\")\n",
        "display(diurnal_kumasi)\n",
        "print(\"\\nSeasonal Patterns for Kumasi (Mean by Month):\")\n",
        "display(seasonal_kumasi)\n",
        "\n",
        "# 3. Compare the environmental conditions between the two locations\n",
        "comparison_mean = pd.DataFrame({\n",
        "    'Tamale_Mean': desc_stats_tamale.loc['mean'],\n",
        "    'Kumasi_Mean': desc_stats_kumasi.loc['mean']\n",
        "})\n",
        "print(\"\\nComparison of Mean Environmental Conditions between Tamale and Kumasi:\")\n",
        "display(comparison_mean)\n",
        "\n",
        "\n",
        "# 4. Analyze the relationship between different environmental parameters within each location (Correlation Matrix)\n",
        "correlation_matrix_tamale = df_tamale[key_params].corr()\n",
        "correlation_matrix_kumasi = df_kumasi[key_params].corr()\n",
        "\n",
        "print(\"\\nCorrelation Matrix for Tamale:\")\n",
        "display(correlation_matrix_tamale)\n",
        "print(\"\\nCorrelation Matrix for Kumasi:\")\n",
        "display(correlation_matrix_kumasi)\n",
        "\n",
        "# 5. Calculate relevant metrics or derived features (VPD - Vapor Pressure Deficit)\n",
        "# Formula for saturation vapor pressure (Es) in kPa: Es = 0.611 * exp((17.27 * T) / (T + 237.3))\n",
        "# Formula for actual vapor pressure (Ea) in kPa: Ea = (Relative Humidity / 100) * Es\n",
        "# Formula for Vapor Pressure Deficit (VPD) in kPa: VPD = Es - Ea\n",
        "\n",
        "def calculate_vpd(df, temp_col, rh_col):\n",
        "    # Convert temperature from oC to Celsius (already in Celsius)\n",
        "    T = df[temp_col]\n",
        "    # Convert relative humidity to a decimal\n",
        "    RH = df[rh_col] / 100\n",
        "\n",
        "    # Calculate saturation vapor pressure (Es) in kPa\n",
        "    Es = 0.611 * np.exp((17.27 * T) / (T + 237.3))\n",
        "\n",
        "    # Calculate actual vapor pressure (Ea) in kPa\n",
        "    Ea = RH * Es\n",
        "\n",
        "    # Calculate Vapor Pressure Deficit (VPD) in kPa\n",
        "    VPD = Es - Ea\n",
        "\n",
        "    return VPD\n",
        "\n",
        "# Calculate VPD for the weather station data in both locations\n",
        "df_tamale['Weather_Station_VPD_kPa'] = calculate_vpd(df_tamale, 'Weather_station_measuring_Temperature_oC', 'Weather_station_measuring_Relative_humidity_of_location')\n",
        "df_kumasi['Weather_Station_VPD_kPa'] = calculate_vpd(df_kumasi, 'Weather_station_measuring_Temperature_oC', 'Weather_station_measuring_Relative_humidity_of_location')\n",
        "\n",
        "print(\"\\nTamale DataFrame with calculated Weather Station VPD:\")\n",
        "display(df_tamale[['Weather_station_measuring_Temperature_oC', 'Weather_station_measuring_Relative_humidity_of_location', 'Weather_Station_VPD_kPa']].head())\n",
        "\n",
        "print(\"\\nKumasi DataFrame with calculated Weather Station VPD:\")\n",
        "display(df_kumasi[['Weather_station_measuring_Temperature_oC', 'Weather_station_measuring_Relative_humidity_of_location', 'Weather_Station_VPD_kPa']].head())"
      ],
