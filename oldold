        "                    print(f\"    Comparing {treatment1} and {treatment2}: T-statistic: {ttest_result.statistic:.4f}, P-value: {ttest_result.pvalue:.4f}\")\n",
        "                elif len(treatment1_data_excel) <= 1 and len(treatment2_data_excel) <= 1:\n",
