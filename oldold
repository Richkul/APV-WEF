      },
      "source": [
        "# Identify columns that represent different treatments based on the names (Agriculture only vs Agrivoltaics plot)\n",
        "treatment_cols = [col for col in df_combined.columns if 'Agriculture only' in col or 'Agrivoltaics plot' in col or 'Agrivoltaic plot' in col or 'Photovoltaics only' in col]\n",
        "\n",
        "# Identify different crop types\n",
        "crop_types = ['tomato', 'pepper', 'Eggplant']\n",
        "\n",
        "# Create a list of relevant columns for analysis (soil moisture, soil temperature, air temperature, relative humidity, solar radiation)\n",
        "analysis_cols = [col for col in treatment_cols if any(crop in col.lower() for crop in crop_types) or 'Photovoltaics only' in col or 'Weather station' in col]\n",
        "\n",
        "# Calculate descriptive statistics for relevant numerical columns, grouped by both 'Site' and inferred treatment (Agriculture only vs Agrivoltaics plot)\n",
        "# This requires creating a 'Treatment' column based on the column names\n",
        "def get_treatment(col_name):\n",
        "    if 'Agriculture only' in col_name:\n",
        "        return 'Agriculture only'\n",
        "    elif 'Agrivoltaics plot' in col_name or 'Agrivoltaic plot' in col_name:\n",
        "        return 'Agrivoltaics plot'\n",
        "    elif 'Photovoltaics only' in col_name:\n",
        "        return 'Photovoltaics only'\n",
        "    elif 'Weather station' in col_name:\n",
        "        return 'Weather station'\n",
        "    else:\n",
        "        return 'Other'\n",
        "\n",
        "# Reshape the dataframe to have a 'Treatment' column\n",
        "df_melted = df_combined.reset_index().melt(id_vars=['Datetime', 'Site'],\n",
        "                                           value_vars=analysis_cols,\n",
        "                                           var_name='Variable',\n",
        "                                           value_name='Value')\n",
        "\n",
        "df_melted['Treatment'] = df_melted['Variable'].apply(get_treatment)\n",
        "\n",
        "# Further refine the 'Variable' column to be more descriptive (e.g., 'Soil Moisture - Tomato', 'Air Temp - Pepper Agrivoltaics')\n",
        "def refine_variable_name(row):\n",
        "    variable = row['Variable']\n",
        "    treatment = row['Treatment']\n",
        "    if treatment in ['Agriculture only', 'Agrivoltaics plot', 'Photovoltaics only']:\n",
        "        # Remove treatment part from the variable name\n",
        "        variable = variable.replace(f' at {treatment}', '')\n",
        "        variable = variable.replace(f' {treatment}', '') # Handle variations in naming\n",
        "        variable = variable.replace('Agrivoltaic plot', '') # Handle variations in naming\n",
        "\n",
        "    # Simplify sensor names\n",
        "    if 'Volumetric soil water/moisture content' in variable:\n",
        "        variable = variable.replace('Volumetric soil water/moisture content', 'Soil Moisture')\n",
        "    elif 'Soil temperature' in variable:\n",
        "        variable = variable.replace('Soil temperature', 'Soil Temp')\n",
        "    elif 'Relative humidity of air with plant canopy' in variable:\n",
        "        variable = variable.replace('Relative humidity of air with plant canopy', 'Canopy Air Humidity')\n",
        "    elif 'Air temperature within plant canopy' in variable:\n",
        "        variable = variable.replace('Air temperature within plant canopy', 'Canopy Air Temp')\n",
        "    elif 'PV solar radiation' in variable:\n",
        "        variable = variable.replace('PV solar radiation', 'PV Radiation')\n",
        "    elif 'PV undestory panel temperature' in variable:\n",
        "        variable = variable.replace('PV undestory panel temperature', 'PV Panel Temp')\n",
        "    elif 'Weather station measuring Relative humidity of location' in variable:\n",
        "        variable = variable.replace('Weather station measuring Relative humidity of location', 'Weather Station Humidity')\n",
        "    elif 'Weather station measuring Temperature' in variable:\n",
        "        variable = variable.replace('Weather station measuring Temperature', 'Weather Station Temp')\n",
        "    elif 'Weather station measuring Precipitation' in variable:\n",
        "        variable = variable.replace('Weather station measuring Precipitation', 'Weather Station Precipitation')\n",
        "\n",
        "\n",
        "    # Extract crop type if applicable\n",
        "    for crop in crop_types:\n",
        "        if crop.lower() in variable.lower():\n",
        "            variable = variable.replace(f'for {crop}', f'- {crop}')\n",
        "            variable = variable.replace(f'for {crop.capitalize()}', f'- {crop.capitalize()}') # Handle capitalization\n",
        "            break # Assume only one crop type per variable for simplicity\n",
        "\n",
        "    # Remove unit information for cleaner names\n",
        "    variable = variable.replace(', relative humidity (%)', '')\n",
        "    variable = variable.replace(' (%)', '')\n",
        "    variable = variable.replace(' (oC)', '')\n",
        "    variable = variable.replace(' (W/m2)', '')\n",
        "    variable = variable.replace(' (mm)', '')\n",
        "\n",
        "\n",
        "    return variable.strip()\n",
        "\n",
        "df_melted['Simplified_Variable'] = df_melted.apply(refine_variable_name, axis=1)\n",
        "\n",
        "\n",
        "# Calculate descriptive statistics grouped by Site, Treatment, and Simplified_Variable\n",
        "descriptive_stats_treatment = df_melted.groupby(['Site', 'Treatment', 'Simplified_Variable'])['Value'].describe()\n",
        "display(descriptive_stats_treatment)"
      ],
