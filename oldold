        "from scipy.stats import ttest_ind\n",
        "\n",
        "# Identify unique simplified variables and treatments\n",
        "simplified_variables = df_melted['Simplified_Variable'].unique()\n",
        "treatments = df_melted['Treatment'].unique()\n",
        "\n",
        "# Perform t-tests to compare means between sites for each variable and treatment\n",
        "print(\"T-tests comparing means between Site Ku and Site T for each variable and treatment:\")\n",
        "for variable in simplified_variables:\n",
        "    for treatment in treatments:\n",
        "        # Filter data for the specific variable and treatment\n",
        "        ku_data = df_melted[(df_melted['Site'] == 'Ku') &\n",
        "                            (df_melted['Treatment'] == treatment) &\n",
        "                            (df_melted['Simplified_Variable'] == variable)]['Value']\n",
        "        t_data = df_melted[(df_melted['Site'] == 'T') &\n",
        "                           (df_melted['Treatment'] == treatment) &\n",
        "                           (df_melted['Simplified_Variable'] == variable)]['Value']\n",
        "\n",
        "        # Drop NaN values before performing t-test\n",
        "        ku_data = ku_data.dropna()\n",
        "        t_data = t_data.dropna()\n",
        "\n",
        "        # Ensure there is enough data to perform the t-test\n",
        "        if len(ku_data) > 1 and len(t_data) > 1:\n",
        "            ttest_result = ttest_ind(ku_data, t_data)\n",
        "            print(f\"  Variable: {variable}, Treatment: {treatment}\")\n",
        "            print(f\"    T-statistic: {ttest_result.statistic:.4f}, P-value: {ttest_result.pvalue:.4f}\")\n",
        "        elif len(ku_data) <= 1 and len(t_data) <= 1:\n",
        "             print(f\"  Variable: {variable}, Treatment: {treatment}\")\n",
        "             print(f\"    Not enough data to perform t-test for both sites.\")\n",
        "        elif len(ku_data) <= 1:\n",
        "             print(f\"  Variable: {variable}, Treatment: {treatment}\")\n",
        "             print(f\"    Not enough data to perform t-test for Site Ku.\")\n",
        "        else:\n",
        "             print(f\"  Variable: {variable}, Treatment: {treatment}\")\n",
        "             print(f\"    Not enough data to perform t-test for Site T.\")\n",
        "\n",
        "\n",
        "# Perform t-tests to compare means between treatments for each site and variable\n",
        "print(\"\\nT-tests comparing means between treatments for each site and variable:\")\n",
        "for site in ['Ku', 'T']:\n",
        "    for variable in simplified_variables:\n",
        "        # Filter data for the specific site and variable\n",
        "        site_data = df_melted[(df_melted['Site'] == site) &\n",
        "                              (df_melted['Simplified_Variable'] == variable)]\n",
        "\n",
        "        # Get unique treatments for this site and variable\n",
        "        site_treatments = site_data['Treatment'].unique()\n",
        "\n",
        "        # Compare each pair of treatments\n",
        "        for i in range(len(site_treatments)):\n",
        "            for j in range(i + 1, len(site_treatments)):\n",
        "                treatment1 = site_treatments[i]\n",
        "                treatment2 = site_treatments[j]\n",
        "\n",
        "                treatment1_data = site_data[site_data['Treatment'] == treatment1]['Value'].dropna()\n",
        "                treatment2_data = site_data[site_data['Treatment'] == treatment2]['Value'].dropna()\n",
        "\n",
        "                # Ensure there is enough data to perform the t-test\n",
        "                if len(treatment1_data) > 1 and len(treatment2_data) > 1:\n",
        "                    ttest_result = ttest_ind(treatment1_data, treatment2_data)\n",
        "                    print(f\"  Site: {site}, Variable: {variable}\")\n",
        "                    print(f\"    Comparing {treatment1} and {treatment2}: T-statistic: {ttest_result.statistic:.4f}, P-value: {ttest_result.pvalue:.4f}\")\n",
        "                elif len(treatment1_data) <= 1 and len(treatment2_data) <= 1:\n",
        "                    print(f\"  Site: {site}, Variable: {variable}\")\n",
        "                    print(f\"    Not enough data to compare {treatment1} and {treatment2}.\")\n",
        "                elif len(treatment1_data) <= 1:\n",
        "                    print(f\"  Site: {site}, Variable: {variable}\")\n",
        "                    print(f\"    Not enough data to compare {treatment1} and {treatment2} (Not enough data for {treatment1}).\")\n",
        "                else:\n",
        "                    print(f\"  Site: {site}, Variable: {variable}\")\n",
        "                    print(f\"    Not enough data to compare {treatment1} and {treatment2} (Not enough data for {treatment2}).\")"
      ],
