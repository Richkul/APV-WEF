        "outputId": "8286852e-bcdb-4719-fb2e-4ff4a875db3a"
      },
      "source": [
        "# Identify columns that represent different treatments based on the names (Agriculture only vs Agrivoltaics plot)\n",
        "treatment_cols_excel = [col for col in df_combined_excel.columns if 'Agriculture only' in col or 'Agrivoltaics plot' in col or 'Agrivoltaic plot' in col or 'Photovoltaics only' in col]\n",
        "\n",
        "# Identify different crop types\n",
        "crop_types = ['tomato', 'pepper', 'Eggplant']\n",
        "\n",
        "# Create a list of relevant columns for analysis (soil moisture, soil temperature, air temperature, relative humidity, solar radiation)\n",
        "analysis_cols_excel = [col for col in treatment_cols_excel if any(crop in col.lower() for crop in crop_types) or 'Photovoltaics only' in col or 'Weather station' in col]\n",
        "\n",
        "# Reshape the dataframe to have a 'Treatment' column\n",
        "df_melted_excel = df_combined_excel.reset_index().melt(id_vars=['Datetime', 'Site'],\n",
        "                                           value_vars=analysis_cols_excel,\n",
        "                                           var_name='Variable',\n",
        "                                           value_name='Value')\n",
        "\n",
        "df_melted_excel['Treatment'] = df_melted_excel['Variable'].apply(get_treatment)\n",
        "\n",
        "# Create a 'Simplified_Variable' column in the melted DataFrame\n",
        "df_melted_excel['Simplified_Variable'] = df_melted_excel.apply(refine_variable_name, axis=1)\n",
        "\n",
        "# Calculate descriptive statistics grouped by Site, Treatment, and Simplified_Variable\n",
        "descriptive_stats_treatment_excel = df_melted_excel.groupby(['Site', 'Treatment', 'Simplified_Variable'])['Value'].describe()\n",
        "display(descriptive_stats_treatment_excel)"
      ],
