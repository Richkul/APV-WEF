      "source": [
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Get the unique list of environmental parameters\n",
        "unique_parameters = melted_df['Parameter'].unique()\n",
        "unique_sites = melted_df['Site'].unique()\n",
        "unique_crops = melted_df['Crop'].unique()\n",
        "\n",
        "# Define colors for crops\n",
        "crop_colors = {'Tomato': 'red', 'Pepper': 'green', 'Eggplant': 'blue'}\n",
        "\n",
        "# Generate boxplots for each parameter, plotting sites separately using matplotlib's boxplot\n",
        "for parameter in unique_parameters:\n",
        "    # Filter data for the current parameter\n",
        "    param_df = melted_df[melted_df['Parameter'] == parameter].copy()\n",
        "\n",
        "    # Create a figure with subplots for each site\n",
        "    fig, axes = plt.subplots(1, len(unique_sites), figsize=(6 * len(unique_sites), 6), sharey=True)\n",
        "\n",
        "    if len(unique_sites) == 1: # Handle case with only one site\n",
        "        axes = [axes]\n",
        "\n",
        "    for i, site in enumerate(unique_sites):\n",
        "        site_df = param_df[param_df['Site'] == site].copy()\n",
        "\n",
        "        # Prepare data for matplotlib boxplot\n",
        "        box_data = []\n",
        "        ticks = []\n",
        "        colors = []\n",
        "        for crop in unique_crops:\n",
        "            crop_data = site_df[site_df['Crop'] == crop]['Measurement'].dropna()\n",
        "            box_data.append(crop_data)\n",
        "            ticks.append(crop)\n",
        "            colors.append(crop_colors.get(crop, 'gray')) # Default to gray if crop not in colors\n",
        "\n",
        "        # Create the boxplot for the current site using matplotlib\n",
        "        if box_data: # Only plot if there is data\n",
        "            bp = axes[i].boxplot(box_data, patch_artist=True, labels=ticks)\n",
        "\n",
        "            # Apply colors to the boxes\n",
        "            for patch, color in zip(bp['boxes'], colors):\n",
        "                patch.set_facecolor(color)\n",
        "\n",
